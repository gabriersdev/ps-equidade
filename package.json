{
  "name": "ps-equidade",
  "version": "1.4.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "update": "npm update",
    "upgrade:deps": "npx npm-check-updates -i && npm install",
    "cypress": "npx cypress run",
    "ci:test": "start-server-and-test dev http://localhost:5173 test",
    "test": "pwd",
    "sync:version": "git pull origin master && node scripts/sync-version.mjs && git add package.json && git commit -m \"build: update version\"",
    "postinstall": "node scripts/patch-eslint-plugin-react.cjs"
  },
  "dependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "bootstrap": "^5.3.8",
    "framer-motion": "^13.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "moment": "^2.30.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.8",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "tar": "^7.5.21",
    "npm": {
      "tar": "^7.5.21",
      "brace-expansion": "^5.0.8"
    }
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "unrs-resolver@1.12.2": true
  }
}
